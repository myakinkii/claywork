# Copy to .env (git-ignored) and fill in. npm start, npm run play and npm run probe read it.

# System One (decision model) for golem reflexes. Any TypeSafe System One endpoint works:
# Alibaba Cloud Model Studio, Jev, or djev-run serving DiffusionGemma.
# Replace {WorkspaceId} with your own (it looks like ws-abc123...), or the server answers 400.
REFLEX_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/systemone
REFLEX_MODEL=decision-model-preview
# REFLEX_KEY falls back to DASHSCOPE_API_KEY.
DASHSCOPE_API_KEY=
# How long a golem may think before its fallback acts (ms). Default 1500 with a real model.
# REFLEX_DEADLINE_MS=1500

# System Two (a chat model) for golems' calm moments: what they say and do outside a fight.
# Same workspace, OpenAI-compatible chat completions. REASON_KEY falls back to DASHSCOPE_API_KEY.
REASON_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
REASON_MODEL=qwen3.8-flash
# REASON_THINKING=1
