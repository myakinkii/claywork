{
  "name": "claywork",
  "private": true,
  "type": "module",
  "description": "A hypertext MUD engine where the clay comes alive",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "typecheck": "tsc -p .",
    "kiln": "node apps/terminal/src/kiln.ts",
    "play": "node --env-file-if-exists=.env apps/terminal/src/play.ts",
    "start": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "probe": "node --env-file-if-exists=.env apps/terminal/src/probe.ts",
    "tiles": "node --env-file-if-exists=.env apps/terminal/src/tiles.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
