{
  "id": "drowned-cellar",
  "title": "The Drowned Cellar",
  "intro": "You step in from the rain and the door of the old potter's house swings shut behind you. Darkness. Somewhere below, they say, a heart of clay still beats.",
  "spawn": "stairwell",
  "things": [
    {
      "id": "stairwell",
      "name": "stairwell",
      "location": null,
      "description": "Wet stone steps spiral down. Rainwater trickles past your boots. One brick low in the wall sits a little crooked.",
      "traits": {
        "room": { "title": "Stairwell", "sounds": "Rain on the roof, far above. Below, water laps against stone." },
        "dark": { "text": "It is pitch black. Rain trickles somewhere above you, and the stone under your feet is slick. You could feel around for things." }
      }
    },
    {
      "id": "stairs_down",
      "name": "stone steps",
      "location": "stairwell",
      "description": "Slick steps leading down. You hear water lapping below.",
      "traits": { "exit": { "to": "cellar", "direction": "down" } }
    },
    {
      "id": "old_shovel",
      "name": "old shovel",
      "location": "stairwell",
      "description": "A potter's clay shovel, its edge still sharp enough to hurt.",
      "traits": { "takeable": {}, "weapon": { "damage": 4 } }
    },
    {
      "id": "loose_brick",
      "name": "crooked brick",
      "location": "stairwell",
      "description": "The brick is loose. You push it, and it slides inward.",
      "traits": {}
    },
    {
      "id": "niche_passage",
      "name": "narrow gap",
      "location": "stairwell",
      "description": "A gap where the wall used to be, barely wide enough to squeeze through.",
      "traits": { "exit": { "to": "niche", "direction": "into the gap", "hidden": true } }
    },

    {
      "id": "cellar",
      "name": "cellar",
      "location": null,
      "description": "Ankle-deep black water covers the floor. An iron chest squats against one wall; an iron door is set into the east wall. A torch sputters in a bracket by the door.",
      "art": "cellar",
      "traits": { "room": { "title": "Flooded Cellar" } }
    },
    {
      "id": "stairs_up",
      "name": "stone steps",
      "location": "cellar",
      "traits": { "exit": { "to": "stairwell", "direction": "up" } }
    },
    {
      "id": "crypt_door",
      "name": "iron door",
      "location": "cellar",
      "description": "Heavy iron, cold to the touch, with a rusted keyhole.",
      "traits": {
        "exit": { "to": "crypt", "direction": "east" },
        "openable": { "open": false },
        "lockable": { "locked": true, "key": "rusty_key" }
      }
    },
    {
      "id": "torch",
      "name": "torch",
      "location": "cellar",
      "description": "A pitch-soaked torch, spitting and smoking. It would light any dark place.",
      "traits": { "takeable": {}, "light": { "lit": true } }
    },
    {
      "id": "iron_chest",
      "name": "iron chest",
      "location": "cellar",
      "description": "A squat iron chest, half sunk in the water. The lid isn't locked, just heavy.",
      "art": {
        "default": "chest_closed",
        "when": [
          { "if": { "all": [{ "prop": ["$target", "openable.open"], "equals": true }, { "at": ["rusty_key", "iron_chest"] }] }, "use": "chest_open" },
          { "if": { "prop": ["$target", "openable.open"], "equals": true }, "use": "chest_empty" }
        ]
      },
      "traits": { "container": {}, "openable": { "open": false } }
    },
    {
      "id": "rusty_key",
      "name": "rusty key",
      "location": "iron_chest",
      "description": "A key flaked with orange rust.",
      "traits": { "takeable": {} }
    },
    {
      "id": "goblin",
      "name": "goblin",
      "location": "cellar",
      "description": "A wiry goblin with a chipped dagger, standing guard in front of the iron door.",
      "art": "goblin",
      "traits": {
        "actor": { "kind": "mob", "archetype": "goblin" },
        "vitals": { "hp": 8, "maxHp": 8 }
      }
    },
    {
      "id": "goblin_dagger",
      "name": "chipped dagger",
      "location": "goblin",
      "description": "A short, chipped blade.",
      "traits": { "takeable": {}, "weapon": { "damage": 2 } }
    },

    {
      "id": "niche",
      "name": "niche",
      "location": null,
      "description": "A tight, dry space behind the wall. Thin cracks and small holes in the far wall let in a flickering orange light, and someone scratched words into the plaster here. Something glints in a crack in the floor.",
      "traits": {
        "room": { "title": "Narrow Niche", "sounds": "Beyond the cracks: water lapping, a torch hissing, and something shuffling back and forth, back and forth." },
        "echo": { "from": "cellar", "muffled": "Through the cracks comes a low, muffled voice. You can't make out the words.", "peek": "Through the cracks, you see" }
      }
    },
    {
      "id": "niche_out",
      "name": "narrow gap",
      "location": "niche",
      "traits": { "exit": { "to": "stairwell", "direction": "back out" } }
    },
    {
      "id": "silver_ring",
      "name": "silver ring",
      "location": "niche",
      "description": "A tarnished silver ring, wedged in a crack in the floor. It still catches the light.",
      "traits": { "takeable": {}, "concealed": {}, "shiny": {} }
    },
    {
      "id": "scratched_words",
      "name": "scratched words",
      "location": "niche",
      "description": "Scratched into the plaster in a shaky hand: \"The heart sleeps behind iron. Its guard is a coward: hurt him, and he runs. Take what beats, and lose what speaks.\"",
      "traits": {}
    },

    {
      "id": "crypt",
      "name": "crypt",
      "location": null,
      "description": "Shelves of small clay figures line the walls, hundreds of them, each one different. In the middle stands a low stone altar.",
      "art": { "default": "crypt", "when": [{ "if": { "flag": "heart_taken" }, "use": "figures_turn" }] },
      "traits": { "room": { "title": "Clay Crypt" } }
    },
    {
      "id": "crypt_out",
      "name": "iron door",
      "location": "crypt",
      "traits": { "exit": { "to": "cellar", "direction": "west" } }
    },
    {
      "id": "altar",
      "name": "stone altar",
      "location": "crypt",
      "description": "A low altar, worn smooth by hands. Two hollows in the stone in front of it look like they were made by knees.",
      "traits": { "container": { "transparent": true }, "shrine": {} }
    },
    {
      "id": "clay_heart",
      "name": "clay heart",
      "location": "altar",
      "description": "A fist-sized heart of unfired clay. It is warm, and very faintly, it beats.",
      "art": "heart",
      "traits": { "takeable": {} }
    }
  ],
