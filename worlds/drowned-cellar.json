  "archetypes": {
    "goblin": {
      "persona": "A cowardly but greedy goblin.",
      "battle": "when-attacked",
      "phases": [
        {
          "id": "paid",
          "when": { "flag": "goblin_paid" },
          "goal": "Run away when you are badly hurt. Attack your foe when your foe attacks you.",
          "calm": "Goblin was paid with a shiny silver ring! Goblin is rich now, and friends with whoever paid. You speak of yourself as \"Goblin\", in short, broken sentences. Goblin dreams of buying warm boots and never standing in cold water again. Goblin lets friends pass through the iron door."
        },
        {
          "id": "guarding",
          "goal": "Run away when you are badly hurt. Attack your foe when your foe is badly hurt. Attack your foe when you are trapped."
        }
      ],
      "repertoire": ["attack", "go", "wait"],
      "calm": {
        "goal": "You guard the iron door, alone in the dark water. You speak of yourself as \"Goblin\", in short, broken sentences. On your mind, and what you mutter about when you think nobody is listening: the rusty key you hid in the heavy iron chest, where nobody ever looks; that Goblin is NOT scared (Goblin is); the warm clay heart behind the iron door, which eats the voice of whoever takes it, the master said; and that when someone hits hard, Goblin always runs, and then comes back. Goblin loves shiny things. When an intruder is near, you threaten them and demand something shiny: nobody passes the iron door without paying.",
        "mutterEvery": 4
      }
    }
  },
  "verbs": {
    "say": {
      "requires": [
        { "unless": { "trait": ["$actor", "mute"] }, "fail": "You open your mouth, and nothing comes out." }
      ]
    },
    "pray": {
      "summary": "Kneel and pray. Some places listen.",
      "phrase": "pray at",
      "aliases": ["kneel"],
      "appliesTo": { "trait": "shrine" },
      "text": "{Actor} kneels before {target}.",
      "you": "You kneel before {target} and pray.",
      "nothing": "The stone is cold and silent."
    }
  },
  "triggers": [
    {
      "id": "brick_secret",
      "on": "look",
      "target": "loose_brick",
      "once": true,
      "then": [
        { "reveal": "niche_passage" },
        { "say": "With a dry scrape, a narrow gap opens in the wall." }
      ]
    },
    {
      "id": "goblin_paid",
      "on": "give",
      "target": "goblin",
      "once": true,
      "if": [{ "trait": ["$with", "shiny"] }],
      "then": [
        { "say": "The goblin snatches the shiny thing, bites it, and grins with all its crooked teeth." },
        { "setFlag": "goblin_paid" },
        { "set": ["goblin", "actor.faction", "players"] }
      ]
    },
    {
      "id": "goblin_not_impressed",
      "on": "give",
      "target": "goblin",
      "if": [{ "not": { "trait": ["$with", "shiny"] } }],
      "then": [
        { "say": "The goblin sniffs it, scowls, and tosses it into the black water. \"Not shiny!\"" },
        { "move": ["$with", "cellar"] }
      ]
    },
    {
      "id": "goblin_guards_door",
      "on": "unlock",
      "phase": "before",
      "target": "crypt_door",
      "if": [{ "prop": ["goblin", "vitals.hp"], "gt": 0 }, { "at": ["goblin", "cellar"] }, { "not": { "flag": "goblin_paid" } }],
      "then": [
        { "say": "The goblin hisses and shoves you away from the door." },
        { "block": true }
      ]
    },
    {
      "id": "crypt_warmth",
      "on": "enter",
      "target": "crypt",
      "once": true,
      "then": [{ "say": "The air in here is warm, like a kiln long after the fire went out.", "to": "actor" }]
    },
    {
      "id": "heart_taken",
      "on": "take",
      "target": "clay_heart",
      "once": true,
      "then": [
        { "say": "As the heart leaves the altar, every clay figure on the shelves turns its head toward you.", "art": "figures_turn" },
        { "grant": ["$actor", "mute"] },
        { "say": "Your throat goes cold. Something has taken your voice in exchange.", "to": "actor" },
        { "setFlag": "heart_taken" }
      ]
    },
    {
      "id": "altar_hums",
      "on": "pray",
      "target": "altar",
      "if": [{ "at": ["clay_heart", "altar"] }],
      "then": [{ "say": "Under your palms the altar hums, and the heart on it beats a little faster.", "to": "actor" }]
    },
    {
      "id": "voice_returns",
      "on": "pray",
      "target": "altar",
      "if": [{ "has": ["$actor", "clay_heart"] }, { "trait": ["$actor", "mute"] }],
      "then": [
        { "revoke": ["$actor", "mute"] },
        { "say": "The heart warms in your hands. Your voice comes back, hoarse, but yours.", "to": "actor" }
      ]
    },
    {
      "id": "figures_move",
      "on": "wait",
      "once": true,
      "if": [{ "at": ["$actor", "crypt"] }, { "still": ["$actor", 3] }],
      "then": [
        { "say": "In the stillness you hear it: hundreds of tiny clay feet shifting on the shelves. When you look up, every figure stands one step closer.", "to": "actor", "art": "figures_closer" },
        { "setFlag": "figures_moved" }
      ]
    }
  ],
  "goal": { "has": ["$actor", "clay_heart"] },
